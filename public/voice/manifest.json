{
  "lines": [
    {
      "text": "Veridelta compares two datasets on their primary keys.",
      "file": "4b51fb40fa1254b3.mp3",
      "seconds": 3.384,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "a440c97874706e9f78d3b0ce45663eb9f49598e98a0a37f2cd6a8b30a91ca50e"
    },
    {
      "text": "It reports every row that differs, under rules you declare.",
      "file": "9e34529cb6166fe2.mp3",
      "seconds": 3.456,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "73db1ab1289fc6ab21c093b4d65437b18539f6a1f6cac1874ec44e17f587f00c"
    },
    {
      "text": "Here are 40 accounts, exported before and after a rewrite.",
      "file": "e95eddd7f631d942.mp3",
      "seconds": 3.816,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "a926d699bd497cb095fabf54a2f37743dbcbd460a1352959d169348587a0b0c6"
    },
    {
      "text": "Did the rewrite keep the data the same?",
      "file": "f1418d9665373b51.mp3",
      "seconds": 2.136,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "c65db2428e8af48cdaaaa48e8d3d621df55f67d20395dc5d38749bdd94b83d3d"
    },
    {
      "text": "One command compares them on the account ID, with no configuration file.",
      "file": "64022b5d32e56802.mp3",
      "seconds": 4.68,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "7263af01bbb9cae3717f98181160f43430e20fd9f4281d92842d551903666a28"
    },
    {
      "text": "39 rows changed, and 1 row is gone.",
      "file": "14f36311ada6135a.mp3",
      "seconds": 3,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "7a709ece94896fb04190a6d3d5ce59789086784f2fe28a8a4bd96d1c0a171e72"
    },
    {
      "text": "The exit code is 1, so a CI job would fail.",
      "file": "879df8ad61e4da17.mp3",
      "seconds": 3.288,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "0dee6d12de11ab940754233c13b33ac6c6b1e1f2211b0aded0e2e5d784734e64"
    },
    {
      "text": "This file names the two exports and the key, with no rules yet.",
      "file": "6ed174e6ec248ea6.mp3",
      "seconds": 4.008,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "aa9575378b850b3e81074a02cac8fca75b85d7dbc54a7f4a94bf3b49ff35d2e6"
    },
    {
      "text": "veridelta suggest tries each kind of rule on the columns that differ.",
      "file": "2abfd10b3a9f1569.mp3",
      "seconds": 3.96,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "a248c104171f635af895ca0ea8aadf0542167ecccaecee48b1e958691c0d9349"
    },
    {
      "text": "It proposes a rule for letter case, rounding, and missing notes, each with its evidence.",
      "file": "9f25f9c5da61f045.mp3",
      "seconds": 5.472,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "25124377194d2f89337e887966d655a34c1fbf2508bc9c5417bcddf27523027f"
    },
    {
      "text": "No model is called. Each rule is one you could write by hand.",
      "file": "fa4cb2711c828621.mp3",
      "seconds": 3.744,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "e41af7d2c96cc420bc9ecc017328a5ede61f0cd66460f5b43fd98026a9177084"
    },
    {
      "text": "The status codes changed too, from words to letters.",
      "file": "376244c369a4c9e2.mp3",
      "seconds": 3.384,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "9397cf5285dd11441dc1e81681ae50a77a1a6d55e525cb8459613d296303cc56"
    },
    {
      "text": "crosswalk lines up the values and proposes a map, with how many rows agree.",
      "file": "a1e4d12c3edbab00.mp3",
      "seconds": 4.656,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "199b0dcecd3ccd9ee5923b2eaca0335eb3ef5c4404175f09590bd2bab0074ed0"
    },
    {
      "text": "The configuration now declares all four rules.",
      "file": "329c340ba4ba9e51.mp3",
      "seconds": 2.784,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "706be9ff5715a13388e8d5c357eabffff5f503c8210f79a498c49f43cc69b9f4"
    },
    {
      "text": "Two rows still differ.",
      "file": "26217d1cb85c48ad.mp3",
      "seconds": 1.248,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "2f3040b7fa18b0ebe656a83cd569fbcccae2de27d3506c34778331bec03ae717"
    },
    {
      "text": "Nothing is forgiven unless a rule says so.",
      "file": "081df29197698633.mp3",
      "seconds": 2.52,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "6da39c08ea14b7f8eab114b6fe28f5a80eae5b11ae6abfe0226540c81df15166"
    },
    {
      "text": "Account 40 was removed on purpose, so a baseline file accepts that change.",
      "file": "cb2d18d6a06ea720.mp3",
      "seconds": 4.968,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "a731f30dbafee76c43d999609ee28f7bc96ab8b6f5930ef189b32a13fc200473"
    },
    {
      "text": "The run accepts it, and still fails on the other row.",
      "file": "8c33d14f917136d6.mp3",
      "seconds": 3.168,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "4d9d711f1b9ee15127dac77fef69a7db686c563a2f9d3e754e0fa2d1090db958"
    },
    {
      "text": "So CI holds the rewrite until that row is fixed.",
      "file": "a46166709d130508.mp3",
      "seconds": 3.024,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "e7da72c6ae4824b6f1934d353b9a7bc30376a7f4f5192f135998f2ad18285465"
    },
    {
      "text": "The HTML report shows that row side by side.",
      "file": "25c552fb30e126d4.mp3",
      "seconds": 3.12,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "8da737061f48fc4bdeb5bf0d6a8c13ad152a098e000eb334a34d151ffca6b259"
    },
    {
      "text": "Account 17 moved from south to east. That is the real defect.",
      "file": "d576a3c6f2f97dd4.mp3",
      "seconds": 4.224,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "f9c48fd0c7ce50431a560a35722dfcff5790e7c4a9919e54039fa7fd3ff1ed25"
    },
    {
      "text": "Veridelta is early, at version 0.33.",
      "file": "236c68c4ab6313ef.mp3",
      "seconds": 3.168,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "412de30d0fa97ef4be7151e73760f1a40491ce366d1285efa8fe500b33d00592"
    },
    {
      "text": "It is tested on generated data, with drift seeded on purpose.",
      "file": "d7806da8c49135dd.mp3",
      "seconds": 3.768,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "c545a20847499a4531e01be2c2c4a156d50124b821885dd6e8315e1cc090ec33"
    },
    {
      "text": "It has not yet been run by other users, or in a live cloud warehouse.",
      "file": "b7808b1341e476cc.mp3",
      "seconds": 4.056,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "6c443682559b7f237075167387a4efc4161f525fb704b859c9b8d7c67a1c541a"
    },
    {
      "text": "Feedback is welcome.",
      "file": "dfdb54a2cdc34418.mp3",
      "seconds": 1.272,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "9142540245885d0a7724b9aba144bb5f9b8f4fd0acbff2931100cc791513ea33"
    },
    {
      "text": "Try it with pip install veridelta.",
      "file": "68369ab5e8831991.mp3",
      "seconds": 2.04,
      "engine": "espeak",
      "voice": "en-us",
      "sha256": "62344c069a0d5bc0127c5d56854d5ba7d24b25e96b83b7ff8e2c5175d33f00ee"
    }
  ]
}
