{
  "lines": [
    {
      "text": "Veridelta compares two datasets on their primary keys.",
      "file": "9e4f540ed79b57a3.mp3",
      "seconds": 3.216,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "e04e7e45938f0423e0118e9b5cd4931ff15b45b1bb7edfabebdb678bdfae54b7"
    },
    {
      "text": "It reports every row that differs, under rules you declare.",
      "file": "bd80db3f9358ff06.mp3",
      "seconds": 3.12,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "00a4dc172fa7752fd78ec8e4869e68d7ef50a02ff04ccf98c7cfa548e04cac4f"
    },
    {
      "text": "Here are 40 accounts, exported before and after a rewrite.",
      "file": "ae49dae04fd00f03.mp3",
      "seconds": 4.008,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "e709dbd555dbf2f77c55c8f569ac5e775a3e97ba54d8074bd8e8e21242894557"
    },
    {
      "text": "Did the rewrite keep the data the same?",
      "file": "9b8426579884ee4b.mp3",
      "seconds": 1.728,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "257c650fe3a6fc7ee9668e94b5cc0180fc7397e1fdc8ed77ebec2a446d7ed152"
    },
    {
      "text": "One command compares them on the account ID, with no configuration file.",
      "file": "2555590d9dca50ce.mp3",
      "seconds": 3.864,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "021837888f3499f566743912a4b5debdffcaa9f024cb0ea90b97d1999ad87bd4"
    },
    {
      "text": "39 rows changed, and 1 row is gone.",
      "file": "742f3b3a859642bb.mp3",
      "seconds": 2.832,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "e8c8c7f4e84603e0f5d8550fd06f4985d442ca8bfebed2f8748be8577b4f0742"
    },
    {
      "text": "The exit code is 1, so a CI job would fail.",
      "file": "c50e9003d6085613.mp3",
      "seconds": 2.76,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "e4cbbe02e9e547772747b7c81e09ed7ab2969a08e88856f30e6ae5d58033d039"
    },
    {
      "text": "This file names the two exports and the key, with no rules yet.",
      "file": "0d7a911126ec9037.mp3",
      "seconds": 3.624,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "90170b116800ed7ca5800a3ba37d073491a26535c4761983cf6b4d0207e57c08"
    },
    {
      "text": "veridelta suggest tries each kind of rule on the columns that differ.",
      "file": "f00d7ee3a6ae092e.mp3",
      "seconds": 4.008,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "492b4f585ce2f0cbfd340844704a012b436f625a309646b14a4756430e864c81"
    },
    {
      "text": "It proposes a rule for letter case, rounding, and missing notes, each with its evidence.",
      "file": "8de5f393d04de085.mp3",
      "seconds": 5.088,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "e7e7ad8bfe77cd9a30268957fde14f4f36fcdb867b8bc12f278a452c8fd356ba"
    },
    {
      "text": "No model is called. Each rule is one you could write by hand.",
      "file": "c80a17cbf26ea128.mp3",
      "seconds": 3.072,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "a0ada805b36749eb671037689e6edec07360cf4438cb0792b427f5fcae6d4b51"
    },
    {
      "text": "The status codes changed too, from words to letters.",
      "file": "e3d6575f6a888501.mp3",
      "seconds": 3.12,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "f42de775bbb208ede75bb567bcdf14d08d83fae3002421e88e6dd98375609a99"
    },
    {
      "text": "crosswalk lines up the values and proposes a map, with how many rows agree.",
      "file": "d6099ee35e4db2ec.mp3",
      "seconds": 4.344,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "e836d7ac35aaa9046d45727e8b2b6a11f2e2c0e1dd4bfcf05e7daa9f1226cfcd"
    },
    {
      "text": "The configuration now declares all four rules.",
      "file": "b7578e811109f77f.mp3",
      "seconds": 2.496,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "c549483eceee2163e578ed558f80676f6e8eb49082c754b39d6bd30b08d87c45"
    },
    {
      "text": "Two rows still differ.",
      "file": "d09917924530fb05.mp3",
      "seconds": 0.96,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "801d70eb353b25342ccdbc3bc9540674650556c11595ba27570c44e534f96835"
    },
    {
      "text": "Nothing is forgiven unless a rule says so.",
      "file": "5559c959a4527db7.mp3",
      "seconds": 2.28,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "e30c6ab1aaf31cd6550571d42c32a8a5b35dd26ba34af68923658fade55fa938"
    },
    {
      "text": "Account 40 was removed on purpose, so a baseline file accepts that change.",
      "file": "577b37b98fdbdb14.mp3",
      "seconds": 4.464,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "a14a3c7ffb1cdc83e979da3642965e677e3264929a0963c180db9c2114a2788c"
    },
    {
      "text": "The run accepts it, and still fails on the other row.",
      "file": "f963269b8116e9b2.mp3",
      "seconds": 3.072,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "f221984bf96a3da8318b8648ff81eddca434b90cb6e76c8b8d5235b14ea56b11"
    },
    {
      "text": "So CI holds the rewrite until that row is fixed.",
      "file": "32db0f4ace249d21.mp3",
      "seconds": 2.832,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "829fb1a7e5106e1c38d2cc2b946820c308bddfeed7d2f0d31037325075a47e3e"
    },
    {
      "text": "The HTML report shows that row side by side.",
      "file": "70d87dd432624f2d.mp3",
      "seconds": 2.928,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "aebb6ade59fe77628bfa23b458881ab17146f5cc68aacc906eaa669ec926245f"
    },
    {
      "text": "Account 17 moved from south to east. That is the real defect.",
      "file": "24bc09069d18f0b5.mp3",
      "seconds": 4.32,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "aa7a03ebd602be619eff44f56f69d65943ef4a2d7d27784487681a6be9cda0d9"
    },
    {
      "text": "Veridelta is early, at version 0.33.",
      "file": "601dae97e326de9b.mp3",
      "seconds": 3.36,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "7a4607126788c83b6c57c777afdd07fac8ec6e56fd90b2505418b12220ea503c"
    },
    {
      "text": "It is tested on generated data, with drift seeded on purpose.",
      "file": "dc021eeb45a628e2.mp3",
      "seconds": 3.504,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "9fe39ed1372ad030a7fd49b793062dd32a626fd863555fa58e0a51e2e5f2b82a"
    },
    {
      "text": "It has not yet been run by other users, or in a live cloud warehouse.",
      "file": "be69a79a11e8f426.mp3",
      "seconds": 3.816,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "bbd855c6a22235ca45dfd422ecc47381aecf143d776e853970dde15a1d85db00"
    },
    {
      "text": "Feedback is welcome.",
      "file": "54de614a154aebb2.mp3",
      "seconds": 0.864,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "71aba2ea4b2af73f11dfee9b40e4f71fc71d5e310c08d0141f1640a1bf7ae7f2"
    },
    {
      "text": "Try it with pip install veridelta.",
      "file": "8e60aba70e6374bf.mp3",
      "seconds": 2.496,
      "engine": "gemini",
      "voice": "Orus",
      "sha256": "6126eefba016baad87229935dedfefa0a2ca500221051b88cff92ef8787d6f00"
    }
  ]
}
